<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the Sandbox-free half of the client's lichess code on a dev host with
       no s&box toolchain: SHA-256, PKCE, the etiquette governor, ndjson framing,
       and the clock/speed floors.

       net10.0 because only the 10.x runtime is installed here (net8 builds but
       won't launch). ImplicitUsings because the client leans on s&box's global
       usings. Same two settings as scripts/seataim_harness. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>lichess_harness</AssemblyName>
    <RootNamespace>LichessHarness</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- The REAL files, verbatim. Nothing is copied or reimplemented here. -->
    <Compile Include="../../client/Code/Api/Lichess/Pkce.cs" />
    <Compile Include="../../client/Code/Api/Lichess/LichessEtiquette.cs" />
    <Compile Include="../../client/Code/Api/Lichess/NdjsonReader.cs" />
  </ItemGroup>

</Project>
