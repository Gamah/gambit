@using System;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@using Gambit.Api;
@namespace Gambit.UI
@inherits PanelComponent

@* Display-only lichess board on the east wall (see InfoWall). A scaled-down MIRROR of the
   engaged InfoScreen's LICHESS page — same title, same green "linked as …" box, the same
   descriptive lines, and the same white lichess-styled button — so from across the room it
   reads like the page you open with E, not a bare status line. Everything ACTIONABLE (the
   copyable link URL, the full disclosure, the unlink/security buttons) still lives ONLY on
   the engaged page; the button here is a look, not a control (no pointer input on a wall
   board), and the security fine-print (scope, key storage) stays on the engaged page rather
   than rotting in two places.

   Link state is read from LichessLinkState, which since HTTPFIX answers "am I linked"
   from THIS PC's own stored key — instantly, offline, and with no first-frame "unknown"
   state. This panel never calls anything itself. *@

<root>
	<div class="board" style="background-color:@WallTheme.Bg; border-color:@WallTheme.Border;">
		<div class="title" style="color:@WallTheme.Text;">LICHESS</div>
		<div class="subtitle" style="color:@WallTheme.TextFaint;">real games on your record</div>
		<div class="divider" style="background-color:@WallTheme.Divider;"></div>

		@if ( !GamchessAuth.Available )
		{
			<div class="intro" style="color:@WallTheme.TextFaint;">Steam required — lichess is off in this build. Local chess is unaffected.</div>
		}
		else if ( LichessLinkState.Linked )
		{
			@* Same green "linked as …" box as the engaged page — ONE interpolated string so the
			   username can't split into its own flex item (the "asgamah" bug). *@
			<div class="linked-row">@($"✓  linked as {LichessLinkState.Username}")</div>
			@* The engaged page's own descriptive lines, mirrored here so the wall reads the
			   same as the page you open. Actionable bits (unlink, the security link) stay on
			   the engaged page only. *@
			<div class="body" style="color:@WallTheme.TextDim;">Sit at a table with another linked player and both choose "play on lichess" — a real game runs on lichess between your accounts and shows up in your history.</div>
			<div class="body" style="color:@WallTheme.TextDim;">Or play a stranger on your own: challenge a lichess player by name, or take a random opponent from lichess's lobby.</div>
			<div class="body" style="color:@WallTheme.TextDim;">Or hand out a shareable link — anyone opens it in a browser and plays you here on the board, no account needed their side.</div>
			<div class="body" style="color:@WallTheme.TextFaint;">None of this happens on its own — two linked players sitting down together just play a local game.</div>
			<div class="body" style="color:@WallTheme.TextFaint;">Your key lives on this PC. Press E for how to turn it off properly.</div>
			<div class="cta">Press E to manage or unlink</div>
		}
		else if ( LichessLinkState.Offline )
		{
			@* Reachable only when NOT linked: the linked branch above is answered from
			   this PC's own key and needs no server at all. So "offline" no longer means
			   "we can't tell" — it means the one thing that DOES need the server (making
			   a new link) can't happen right now. *@
			<div class="intro" style="color:@WallTheme.TextDim;">No lichess account linked on this PC — and the Gambit server is unreachable, so linking one will have to wait. Chess still works.</div>
			<div class="cta">Press E</div>
		}
		else
		{
			<div class="body" style="color:@WallTheme.TextDim;">Link your lichess account and a game here can be a real, rated game on lichess — against whoever sits opposite you, a player you name, a random stranger, or anyone you send a link.</div>
			<div class="body" style="color:@WallTheme.TextFaint;">A game here is local and touches no lichess account unless you pick a lichess option. Press E for exactly what linking does and what we ask for.</div>
			<div class="cta">Press E to link</div>
		}
	</div>
</root>

<style>
	@@import "WallTheme.scss";

	root {
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	/* Same intrinsic-pixel-space rules as DevNotesPanel/CenterInfoPanel: tune the
	   px values, never the GO scale, to fix overflow. */
	.board {
		width: 100%;
		height: auto;
		flex-direction: column;
		align-items: stretch;
		justify-content: flex-start;
		padding: $wall-pad;
		border: $wall-border solid;
		border-radius: $wall-radius;
		font-family: $wall-font;
		gap: $wall-gap;
	}

	.board > div {
		flex-shrink: 0;
	}

	/* Colour is bound inline (@@WallTheme.Text) like the other boards' titles, so it
	   retints with the room theme. It used to hardcode a grey here and was the only
	   trio title that didn't follow the accent. */
	.title {
		font-size: $wall-fs-title-sm;
		font-weight: bold;
		letter-spacing: 3px;
		text-align: center;
	}

	/* A stable value-proposition line under the title — echoes the engaged panel's tone
	   without restoring any fact that rots (see the header note). */
	.subtitle {
		font-size: $wall-fs-fine;
		letter-spacing: 1px;
		text-align: center;
	}

	/* Descriptive lines mirrored from the engaged page. Left-aligned and pre-wrap, exactly
	   like the engaged .body, so long lines wrap and the div grows (pre-wrap is the shape
	   that grows on a panel; a bare div can clip a wrapped line). */
	.body {
		font-size: $wall-fs-body;
		line-height: 1.35;
		white-space: pre-wrap;
		text-align: left;
	}

	.divider {
		height: $wall-divider-h;
		margin: $wall-divider-gap 0;
	}

	/* The not-linked / edge-case line under the divider. One div per line — a div's auto
	   height doesn't grow for wrapped text. */
	.intro {
		font-size: $wall-fs-fine;
		text-align: center;
		justify-content: center;
	}

	/* The green "✓ linked as …" box — the engaged panel's .linked-row, scaled to the wall.
	   Static green (not theme-driven) on purpose: linked-confirmation is a fixed meaning. */
	.linked-row {
		justify-content: center;
		padding: 3px 6px;
		border-radius: $wall-radius;
		background-color: rgba(130, 220, 130, 0.12);
		border: $wall-border solid rgba(130, 220, 130, 0.45);
		color: rgba(150, 235, 150, 0.95);
		font-size: $wall-fs-body;
		font-weight: bold;
		text-align: center;
	}

	/* The engaged panel's white lichess button, scaled down. A LOOK, not a control —
	   this board takes no pointer input; it just makes the wall read like the page you
	   open with E. lichess's own black-on-white, so it reads as "this goes to lichess". */
	.cta {
		justify-content: center;
		margin-top: 2px;
		padding: 3px 6px;
		border-radius: $wall-radius;
		background-color: rgba(240, 240, 240, 0.2);
		border: $wall-border solid rgba(240, 240, 240, 0.55);
		color: rgba(255, 255, 255, 0.92);
		font-size: $wall-fs-body;
		font-weight: bold;
		letter-spacing: 1px;
		text-align: center;
	}
</style>

@code
{
	/// <summary>World units to keep between the content's bottom edge and the floor.</summary>
	[Property] public float FloorClearance { get; set; } = 60f;

	protected override int BuildHash() =>
		HashCode.Combine( LichessLinkState.Linked, LichessLinkState.Username,
			LichessLinkState.Offline, GamchessAuth.Available,
			SettingsModel.SettingsVersion );

	protected override void OnUpdate()
	{
		// Every wall board anchors the same way, from one place — see
		// WallBoardGeometry. Do not re-derive this here.
		Gambit.World.WallBoardGeometry.FloorAnchor( this, FloorClearance );
	}
}
