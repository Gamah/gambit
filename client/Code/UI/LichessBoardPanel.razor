@using System;
@using System.Linq;
@using Sandbox;
@using Sandbox.UI;
@using Gambit.Api;
@namespace Gambit.UI
@inherits PanelComponent

@* Display-only lichess board on the east wall (see InfoWall). A scaled-down echo of the
   engaged InfoScreen's LICHESS page — same title, same green "linked as …" box, same white
   lichess-styled button — so from across the room it previews the page you open with E.
   Everything ACTIONABLE (the copyable link URL, the disclosure, the unlink button) still
   lives only in the engaged page; the button here is a look, not a control (no pointer
   input on a wall board).

   Link state is read from LichessLinkState, which does the polling; this panel
   never calls gamchess itself. *@

<root>
	@* Scaled-down echo of the engaged InfoScreen's LICHESS page: the same title, the same
	   green "✓ linked as …" box when linked, and the same white lichess-styled button — so
	   from across the room it reads as the page you'll open, not a bare status line. The
	   button is a LOOK, not a control (this is a display board, no pointer input); the real
	   copyable link/unlink live in the engaged page. *@
	<div class="board" style="background-color:@WallTheme.Bg; border-color:@WallTheme.Border;">
		<div class="title" style="color:@WallTheme.Text;">LICHESS</div>
		<div class="subtitle" style="color:@WallTheme.TextFaint;">real games on your record</div>
		<div class="divider" style="background-color:@WallTheme.Divider;"></div>

		@if ( !GamchessAuth.Available )
		{
			<div class="intro" style="color:@WallTheme.TextFaint;">Steam required — lichess is off in this build.</div>
		}
		else if ( LichessLinkState.Linked )
		{
			<div class="linked-row">✓  linked as @LichessLinkState.Username</div>
			<div class="cta">Press E to play</div>
		}
		else
		{
			<div class="intro" style="color:@WallTheme.TextDim;">@( LichessLinkState.Offline ? "Offline — can't check your link right now." : "Link an account to play real, rated games from a table." )</div>
			<div class="cta">Press E to link</div>
		}
	</div>
</root>

<style>
	@@import "WallTheme.scss";

	root {
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	/* Same intrinsic-pixel-space rules as DevNotesPanel/CenterInfoPanel: tune the
	   px values, never the GO scale, to fix overflow. */
	.board {
		width: 100%;
		height: auto;
		flex-direction: column;
		align-items: stretch;
		justify-content: flex-start;
		padding: $wall-pad;
		border: $wall-border solid;
		border-radius: $wall-radius;
		font-family: $wall-font;
		gap: $wall-gap;
	}

	.board > div {
		flex-shrink: 0;
	}

	/* Colour is bound inline (@@WallTheme.Text) like the other boards' titles, so it
	   retints with the room theme. It used to hardcode a grey here and was the only
	   trio title that didn't follow the accent. */
	.title {
		font-size: $wall-fs-title-sm;
		font-weight: bold;
		letter-spacing: 3px;
		text-align: center;
	}

	/* A stable value-proposition line under the title — echoes the engaged panel's tone
	   without restoring any fact that rots (see the header note). */
	.subtitle {
		font-size: $wall-fs-fine;
		letter-spacing: 1px;
		text-align: center;
	}

	.divider {
		height: $wall-divider-h;
		margin: $wall-divider-gap 0;
	}

	/* The not-linked / edge-case line under the divider. One div per line — a div's auto
	   height doesn't grow for wrapped text. */
	.intro {
		font-size: $wall-fs-fine;
		text-align: center;
		justify-content: center;
	}

	/* The green "✓ linked as …" box — the engaged panel's .linked-row, scaled to the wall.
	   Static green (not theme-driven) on purpose: linked-confirmation is a fixed meaning. */
	.linked-row {
		justify-content: center;
		padding: 3px 6px;
		border-radius: $wall-radius;
		background-color: rgba(130, 220, 130, 0.12);
		border: $wall-border solid rgba(130, 220, 130, 0.45);
		color: rgba(150, 235, 150, 0.95);
		font-size: $wall-fs-body;
		font-weight: bold;
		text-align: center;
	}

	/* The engaged panel's white lichess button, scaled down. A LOOK, not a control —
	   this board takes no pointer input; it just makes the wall read like the page you
	   open with E. lichess's own black-on-white, so it reads as "this goes to lichess". */
	.cta {
		justify-content: center;
		margin-top: 2px;
		padding: 3px 6px;
		border-radius: $wall-radius;
		background-color: rgba(240, 240, 240, 0.2);
		border: $wall-border solid rgba(240, 240, 240, 0.55);
		color: rgba(255, 255, 255, 0.92);
		font-size: $wall-fs-body;
		font-weight: bold;
		letter-spacing: 1px;
		text-align: center;
	}
</style>

@code
{
	/// <summary>World units to keep between the content's bottom edge and the floor.</summary>
	[Property] public float FloorClearance { get; set; } = 60f;

	protected override int BuildHash() =>
		HashCode.Combine( LichessLinkState.Linked, LichessLinkState.Username,
			LichessLinkState.Offline, GamchessAuth.Available,
			SettingsModel.SettingsVersion );

	protected override void OnUpdate()
	{
		// Every wall board anchors the same way, from one place — see
		// WallBoardGeometry. Do not re-derive this here.
		Gambit.World.WallBoardGeometry.FloorAnchor( this, FloorClearance );
	}
}
