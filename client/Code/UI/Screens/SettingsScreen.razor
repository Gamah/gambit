@using System;
@using Sandbox;
@using Sandbox.UI;
@using Gambit.UI;
@using Gambit.World;
@namespace Gambit.UI.Screens
@inherits PanelComponent

@*
	Interactive editor for the south-wall settings boards (issue #49). The wall
	boards are display-only WorldPanels; this is the real UI — a screen-space
	ScreenPanel shown (centered) while the player is locked onto a board
	(SettingsStation). The camera doesn't move for boards, so this just draws on
	screen. Plain ScreenPanel input, so the cursor and clicks just work. Rows come
	from the shared SettingsModel.
*@

<root>
	@* Hidden while BOARD SETTINGS is up, rather than stacked under it. Both cards are 620px
	   and centred and this one is much taller, so its top and bottom rows poke out past the
	   board card and read as one garbled panel — and WallTheme.Bg is fully opaque, so this is
	   geometry, not translucency and not a z-order bug (root here has no z-index; the board
	   panel's is 60). The station stays engaged underneath: closing the board panel with Esc
	   or ✕ brings this straight back, which is what "opened it from here" should mean. *@
	@if ( SettingsStation.Active != null && !BoardSettingsScreen.IsOpen )
	{
	<div class="board-fit">
		<div class="settings" style="background-color:@WallTheme.Bg; border:1.5px solid @WallTheme.Border;">
			<div class="title" style="color:@WallTheme.Text;">@( SettingsStation.Active.Host ? "HOST SETTINGS" : "WORLD SETTINGS" )</div>
			<div class="divider" style="background-color:@WallTheme.Divider;"></div>
			@foreach ( var row in Rows() )
			{
				<div class="row">
					<div class="label" style="color:@WallTheme.TextFaint;">@row.Label</div>
					@if ( row.Slider is { } sl )
					{
						<SliderControl class="wslider" Min="@sl.Min" Max="@sl.Max" Value="@sl.Value" OnValueChanged="@sl.OnChange"></SliderControl>
					}
					else if ( row.Cells.Count > 0 )
					{
						<div class="cells">
							@foreach ( var cell in row.Cells )
							{
								var c = cell;
								<div class="cell @c.Css @( c.Selected ? "selected" : "" ) @( c.Activate == null ? "disabled" : "" )" style="@CellStyle( c )" onclick="@( () => Click( c ) )">@c.Label</div>
							}
						</div>
					}
				</div>
			}
			@* The second door to BOARD SETTINGS (issue #28). Those seven rows left this panel —
			   it is the ROOM now — but someone standing at the wall who isn't sitting down still
			   has to be able to reach them, and every row there is client-local so none of them
			   needs a seat. One editor, two doors: nothing duplicated, nothing to keep in step.
			   Host settings are the admin's board-count panel and have nothing to do with these. *@
			@if ( !( SettingsStation.Active?.Host ?? false ) )
			{
				<div class="board-door" style="background-color:@WallTheme.Cell; color:@WallTheme.Text;"
					onclick="@( () => OpenBoardSettings() )">⚙  BOARD SETTINGS — how boards look, sound and play</div>
			}
		</div>
	</div>
	}
</root>

<style>
	@@import "../WallTheme.scss";

	root {
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	// camera no longer moves for boards — just centre the panel on the screen
	.board-fit {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		align-items: center;
		justify-content: center;
		pointer-events: none;
	}

	.settings {
		width: 620px;
		flex-direction: column;
		align-items: stretch;
		justify-content: flex-start;
		padding: 28px 34px;
		border-radius: $wall-radius;
		font-family: $wall-font;
		gap: 14px;
		pointer-events: all;
	}

	.settings > div {
		flex-shrink: 0;
	}

	.title {
		justify-content: center;
		white-space: nowrap;
		font-size: 26px;
		font-weight: bold;
		letter-spacing: 4px;
	}

	.divider {
		height: 2px;
		margin: 6px 0;
	}

	.row {
		flex-direction: column;
		gap: 6px;
	}

	.label {
		font-size: 16px;
		letter-spacing: 2px;
		white-space: nowrap;
	}

	.cells {
		flex-direction: row;
		gap: 8px;
	}

	/* Real draggable slider for the continuous settings (M12), replacing the old
	   rotaliate tick bars. Full-width in the row; pointer-events must be on so the
	   thumb can be dragged. The panel doesn't scroll, so there's no drag-scroll fight
	   (see the CLAUDE.md rule about overflow: scroll + draggable controls). */
	.wslider {
		width: 100%;
		height: 24px;
		pointer-events: all;
	}

	/* Hide SliderControl's built-in value bubble — it renders as a bare black box
	   (its .value-tooltip .label has a hardcoded black background in the base scss),
	   and it's redundant here anyway: the row label above already shows the value. */
	.wslider .value-tooltip {
		display: none;
	}

	/* Base bg/colour are inline (runtime theme, CellStyle); only layout + the hover/
	   selected border feedback live here. Inline bg defeats a :hover bg, so hover
	   feedback is the border alone. */
	.cell {
		justify-content: center;
		align-items: center;
		font-size: 16px;
		border: 2px solid transparent;
		border-radius: $wall-radius;
		cursor: pointer;
		pointer-events: all;
	}

	.cell:hover {
		border: 2px solid rgba(255, 255, 255, 0.6);
	}

	.cell.swatch {
		width: 42px;
		height: 34px;
	}

	.cell.tick {
		width: 30px;
		height: 34px;
	}

	.cell.toggle {
		padding: 4px 16px;
		height: 34px;
	}

	/* narrow enough that the full 2–16 cabinet row fits the board width */
	.cell.num {
		padding: 4px 9px;
		height: 34px;
	}

	.cell.selected {
		border: 2px solid rgba(255, 255, 255, 0.85);
	}

	.cell.disabled {
		cursor: default;
	}

	.cell.disabled:hover {
		border: 2px solid transparent;
	}

	/* The BOARD SETTINGS door. A full-width row rather than a cell in the list: it is not a
	   setting, it opens another panel, and it should not read as one more thing to toggle. */
	.board-door {
		justify-content: center;
		align-items: center;
		height: 40px;
		margin-top: 6px;
		font-size: 16px;
		letter-spacing: 2px;
		white-space: nowrap;
		border: 2px solid rgba(255, 255, 255, 0.35);
		border-radius: $wall-radius;
		cursor: pointer;
		pointer-events: all;
	}

	.board-door:hover {
		border: 2px solid rgba(255, 255, 255, 0.85);
	}
</style>

@code
{
	// Runtime theme colours for a cell, merged with the cell's own Style last so swatch
	// cells keep their real light-colour swatch background.
	string CellStyle( SettingsModel.SettingCell c )
	{
		bool filled = c.Css != null && c.Css.Contains( "filled" );
		string s = $"background-color:{( filled ? WallTheme.CellFill : WallTheme.Cell )};";
		s += c.Activate == null ? " color:rgba(255,255,255,0.25);" : $" color:{WallTheme.TextDim};";
		return s + c.Style;
	}

	System.Collections.Generic.List<SettingsModel.SettingRow> Rows() =>
		SettingsStation.Active?.Host ?? false
			? SettingsModel.BuildHostRows( Scene )
			: SettingsModel.BuildLocalRows();

	// Open the board panel over this one. It draws itself (self-attached to the same ScreenPanel,
	// z-index above this) and closes back to here; this screen stays up underneath, so the wall
	// board is still where you came from. Escape while at a wall board closes whichever is on top —
	// LobbyPlayer routes it at the board panel first.
	void OpenBoardSettings() => BoardSettingsScreen.Open();

	void Click( SettingsModel.SettingCell cell )
	{
		if ( cell?.Activate == null ) return;
		cell.Activate();
		Gambit.Audio.SoundPlayer.PlayTick();
		StateHasChanged();
	}

	protected override int BuildHash() =>
		HashCode.Combine( SettingsStation.Active != null && !BoardSettingsScreen.IsOpen,
			SettingsStation.Active?.Host,
			SettingsModel.SettingsVersion, LobbyNetworkManager.LocalIsAdmin,
			HashCode.Combine( ChessRing.Instance?.StationCount ?? 0,
				ChessRing.Instance?.PendingStationCount ?? 0,
				ChessRing.Instance?.Rebuilding ?? false ),
			SettingsModel.AnyStationOccupied( Scene ) );
}
