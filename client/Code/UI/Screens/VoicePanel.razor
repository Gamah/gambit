@using System
@using System.Linq
@using Sandbox
@using Sandbox.UI
@using Gambit.Game
@using Gambit.World
@namespace Gambit.UI.Screens
@inherits PanelComponent

@*
	The proximity-voice MUTE ROSTER, shown only while VoiceScreen.IsOpen: one row per other player
	with a speaking dot, MUTED state and the selected-row highlight. pointer-events: none — it is
	navigated with ↑/↓, never the cursor, so mouselook is never interrupted.

	The G/B keycap hints this panel used to draw now live in HudHints, with chat's and music's —
	one stack, one style, one place to read the controls off. Keys are still handled by VoiceScreen
	(G toggles voice, B opens this roster).

	NOTE the s&box gotcha: NO inline <span>s inside a line of text — panels lay children out as flex
	items, not inline flow, so mixed spans shatter a paragraph into columns. Block lines only.
*@

<root>
	@{
		var screen = Driver;
	}

	@if ( screen is not null && screen.IsOpen )
	{
		<div class="roster @( BoardSettingsScreen.ButtonShowing ? "raised" : "" )">
			<div class="roster-title">MUTE PLAYERS</div>
			@{
				var rows = screen.Roster;
			}
			@for ( int i = 0; i < rows.Count; i++ )
			{
				var conn = rows[i];
				var muted = VoicePrefs.IsMuted( conn.SteamId );
				var selected = i == screen.SelectedIndex;
				var voice = screen.VoiceFor( conn );
				var speaking = voice.IsValid() && voice.LastPlayed < 0.3f;

				<div class="row @( selected ? "sel" : "" )">
					<div class="dot @( speaking ? "live" : "" )"></div>
					<div class="name">@conn.DisplayName</div>
					<div class="state @( muted ? "muted" : "" )">@( muted ? "MUTED" : "" )</div>
				</div>
			}
			<div class="roster-foot">↑↓ select · Enter mute · Esc close</div>
		</div>
	}
</root>

<style>
	root {
		width: 100%;
		height: 100%;
		pointer-events: none;
		font-family: Poppins, sans-serif;
	}

	/* Opens above the HudHints stack (which sits at bottom: 44px, or 78 when the seated BOARD
	   SETTINGS pill takes the corner) — keep all three in step. */
	.roster {
		position: absolute;
		left: 16px;
		bottom: 100px;
		flex-direction: column;
		width: 320px;
		padding: 12px 14px;
		border-radius: 12px;
		background-color: rgba(8, 10, 16, 0.92);
		border-width: 1px;
		border-color: rgba(110, 211, 255, 0.4);
		pointer-events: none;
	}

	/* Follows the hints stack up by the same 34px when the seated pill is on screen. */
	.roster.raised {
		bottom: 134px;
	}

	.roster-title {
		font-size: 13px;
		font-weight: 800;
		letter-spacing: 1px;
		color: #6fd3ff;
		margin-bottom: 8px;
	}

	.row {
		flex-direction: row;
		align-items: center;
		gap: 10px;
		padding: 5px 8px;
		border-radius: 7px;
		margin-bottom: 2px;
	}

	.row.sel {
		background-color: rgba(110, 211, 255, 0.18);
		border-width: 1px;
		border-color: rgba(110, 211, 255, 0.5);
	}

	.row .dot {
		width: 9px;
		height: 9px;
		border-radius: 5px;
		background-color: rgba(255, 255, 255, 0.18);
	}

	.row .dot.live {
		background-color: #2ecc71;
	}

	.row .name {
		flex-grow: 1;
		font-size: 15px;
		font-weight: 600;
		color: rgba(255, 255, 255, 0.9);
	}

	.row .state {
		font-size: 12px;
		font-weight: 700;
		color: rgba(255, 110, 110, 0.95);
	}

	.roster-foot {
		font-size: 12px;
		color: rgba(255, 255, 255, 0.5);
		margin-top: 8px;
	}
</style>

@code
{
	private VoiceScreen _driver;
	private VoiceScreen Driver => _driver ??= Scene?.GetAllComponents<VoiceScreen>().FirstOrDefault();

	protected override int BuildHash()
	{
		var screen = Driver;
		int speaking = 0;
		if ( screen is not null && screen.IsOpen )
		{
			foreach ( var c in screen.Roster )
			{
				var v = screen.VoiceFor( c );
				speaking = HashCode.Combine( speaking, v.IsValid() && v.LastPlayed < 0.3f );
			}
		}

		return HashCode.Combine(
			screen?.IsOpen ?? false,
			screen?.SelectedIndex ?? -1,
			screen?.Roster.Count ?? 0,
			VoicePrefs.MutedCount,
			speaking,
			BoardSettingsScreen.ButtonShowing );
	}
}
